# droid-re-chain environment variables
# Copy this file to .env and fill in your paths.

# Android NDK root (required for NDK compilation tools)
# macOS Homebrew: /opt/homebrew/share/android-commandlinetools/ndk/25.2.9519653
# Linux default:  ~/Android/Sdk/ndk/25.2.9519653
# Windows:        C:\Users\you\AppData\Local\Android\Sdk\ndk\25.2.9519653
ANDROID_NDK_HOME=

# Android SDK root (optional, for apksigner/aapt)
ANDROID_SDK_ROOT=

# Custom ADB host/port (default: 127.0.0.1:5555)
ADB_HOST=127.0.0.1
ADB_PORT=5555