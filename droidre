#!/usr/bin/env bash
# droidre — CLI entry point for droid-re-chain MCP server.
# Usage:
#   droidre              # stdio mode (for MCP hosts)
#   droidre --sse        # SSE mode
#   droidre --sse --port 8080
#   droidre --help
#
# Installed by:
#   pip install -e .     # creates droidre via console_scripts
#   install.sh           # symlinks this script to ~/.local/bin/droidre
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$SCRIPT_DIR"

# If pip-installed (console_scripts), the wrapper is in some bin dir
# and PROJECT_ROOT is wrong. Try to find the real project root.
if [ ! -f "$PROJECT_ROOT/src/server.py" ]; then
  # Walk up looking for src/server.py
  DIR="$SCRIPT_DIR"
  while [ "$DIR" != "/" ]; do
    if [ -f "$DIR/src/server.py" ]; then
      PROJECT_ROOT="$DIR"
      break
    fi
    DIR="$(dirname "$DIR")"
  done
fi

cd "$PROJECT_ROOT"

# Inherit ANDROID_NDK_HOME from environment, or try common paths
if [ -z "${ANDROID_NDK_HOME:-}" ]; then
  for candidate in \
    /opt/homebrew/share/android-commandlinetools/ndk/25.2.9519653 \
    /usr/local/share/android-ndk \
    "$HOME/Android/Sdk/ndk/25.2.9519653" \
    "$HOME/android-ndk"; do
    if [ -d "$candidate" ]; then
      export ANDROID_NDK_HOME="$candidate"
      break
    fi
  done
fi

exec python3 -m src.server "$@"
