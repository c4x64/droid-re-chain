#!/usr/bin/env bash
# droidre — CLI entry point for droid-re-chain MCP server.
# Usage:
#   droidre                       # stdio mode (for MCP hosts)
#   droidre --sse                 # SSE mode (port 8000, localhost)
#   droidre --sse --port 8080     # custom port
#   droidre --sse --host 0.0.0.0  # listen on all interfaces
#   droidre --help
#
# Installed by:
#   pip install -e .     # creates droidre via console_scripts
#   install.sh           # symlinks this script to ~/.local/bin/droidre
set -euo pipefail

# Resolve symlink to get the real script location
SCRIPT_SRC="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_SRC" ]; do
  TARGET="$(readlink "$SCRIPT_SRC")"
  if [[ "$TARGET" == /* ]]; then
    SCRIPT_SRC="$TARGET"
  else
    SCRIPT_SRC="$(dirname "$SCRIPT_SRC")/$TARGET"
  fi
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SRC")" && pwd)"
PROJECT_ROOT="$SCRIPT_DIR"

# If pip-installed (console_scripts), the wrapper is in a site-packages bin dir.
# Walk up looking for src/server.py to find the real project root.
if [ ! -f "$PROJECT_ROOT/src/server.py" ]; then
  DIR="$SCRIPT_DIR"
  while [ "$DIR" != "/" ]; do
    if [ -f "$DIR/src/server.py" ]; then
      PROJECT_ROOT="$DIR"
      break
    fi
    DIR="$(dirname "$DIR")"
  done
fi

cd "$PROJECT_ROOT"

# Inherit ANDROID_NDK_HOME from environment, or try common paths
if [ -z "${ANDROID_NDK_HOME:-}" ]; then
  for candidate in \
    /opt/homebrew/share/android-commandlinetools/ndk/25.2.9519653 \
    /usr/local/share/android-ndk \
    "$HOME/Android/Sdk/ndk/25.2.9519653" \
    "$HOME/android-ndk"; do
    if [ -d "$candidate" ]; then
      export ANDROID_NDK_HOME="$candidate"
      break
    fi
  done
fi

exec python3 -m src.server "$@"
